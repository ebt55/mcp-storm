    "files": {
      "inputs/people.json": "[{\"name\":\"ada\",\"city\":\"berlin\"},{\"name\":\"bob\",\"city\":\"oslo\"},{\"name\":\"cyd\",\"city\":\"lima\"},{\"name\":\"dee\",\"city\":\"oslo\"}]\n"
    }
  },
  "expected_calls": [
    "read_file",
    "create_table",
    "write_query",
    "read_query",
    "create_directory",
    "write_file"
  ],
  "grader": [
    {
      "type": "sql_rows",
      "query": "SELECT name, city FROM people ORDER BY name",
      "rows": [
        {
          "name": "ada",
          "city": "berlin"
        },
        {
          "name": "bob",
          "city": "oslo"
        },
        {
          "name": "cyd",
          "city": "lima"
        },
        {
          "name": "dee",
          "city": "oslo"
        }
      ]
    },
    {
      "type": "file_number",
      "path": "out/n.txt",
      "equals": 4
    }
  ]
}
