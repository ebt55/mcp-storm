{
  "id": "xs-01",
  "prompt": "inputs/people.json holds a JSON array of {\"name\":..., \"city\":...} objects. Create a table people(name TEXT, city TEXT), insert every person, and write out/n.txt with the number of people.",
  "servers": [
    "filesystem",
    "sqlite"
  ],
