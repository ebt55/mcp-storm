      "inputs/app.log": "started\n",
      "inputs/data.log": "rows=9\n",
      "inputs/keep.txt": "stay\n"
    }
  },
  "expected_calls": [
    "create_directory",
    "move_file",
    "move_file"
  ],
  "grader": [
