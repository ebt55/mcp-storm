    {
      "type": "file_contains",
      "path": "archive/data.log",
      "text": "rows=9"
    },
    {
      "type": "file_absent",
      "path": "inputs/app.log"
    },
    {
      "type": "file_absent",
      "path": "inputs/data.log"
    },
    {
      "type": "file_exists",
